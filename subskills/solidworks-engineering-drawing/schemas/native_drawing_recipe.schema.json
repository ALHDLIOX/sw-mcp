{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native associative drawing recipe",
  "type": "object", "additionalProperties": false,
  "required": ["recipeVersion", "sourceModel", "modelSizeMm", "views", "dimensions", "titleBlock"],
  "properties": {
    "recipeVersion": {"const": "1.0"},
    "sourceModel": {"type": "string", "minLength": 1},
    "modelSizeMm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
    "basename": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "default": "drawing"},
    "standard": {"enum": ["ISO", "GB_T"], "default": "ISO"},
    "scale": {"type": "number", "exclusiveMinimum": 0, "default": 2},
    "views": {"type": "array", "minItems": 3, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "positionMm"],
      "properties": {"name": {"enum": ["Front", "Top", "Right", "Isometric"]},
        "positionMm": {"$ref": "#/$defs/point2"}, "centerMarks": {"type": "integer", "minimum": 0}}
    }},
    "dimensions": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "view", "kind", "entities", "positionMm", "expectedMm"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "view": {"type": "string"}, "kind": {"enum": ["horizontal", "vertical", "diameter"]},
        "entities": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/entity"}},
        "positionMm": {"$ref": "#/$defs/point2"}, "expectedMm": {"type": "number", "exclusiveMinimum": 0},
        "prefix": {"type": "string"}, "suffix": {"type": "string"}}
    }},
    "notes": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["text", "positionMm"],
      "properties": {"text": {"type": "string", "minLength": 1}, "positionMm": {"$ref": "#/$defs/point2"},
        "view": {"type": "string"}, "entity": {"$ref": "#/$defs/entity"},
        "heightMm": {"type": "number", "minimum": 1.5, "maximum": 6}}
    }},
    "titleBlock": {"type": "object", "additionalProperties": false, "required": ["title", "drawingNumber"],
      "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 45},
        "drawingNumber": {"type": "string", "minLength": 1, "maxLength": 24},
        "material": {"type": "string", "maxLength": 25}, "date": {"type": "string", "maxLength": 14}}}
  },
  "$defs": {
    "point2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "point3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "entity": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type", "pointMm"],
        "properties": {"type": {"const": "vertex"}, "pointMm": {"$ref": "#/$defs/point3"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "startMm", "endMm"],
        "properties": {"type": {"const": "line"}, "startMm": {"$ref": "#/$defs/point3"}, "endMm": {"$ref": "#/$defs/point3"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "centerMm", "radiusMm"],
        "properties": {"type": {"const": "circle"}, "centerMm": {"$ref": "#/$defs/point3"}, "radiusMm": {"type": "number", "exclusiveMinimum": 0}}}
    ]}
  }
}
